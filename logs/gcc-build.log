            mv include/$file include/x_$file; \
            echo "#include_next <$file>" >include/$file; \
            cat include/x_$file >>include/$file; \
            rm -f include/x_$file; \
    chmod a+r include/$file; \
  fi; \
done
for file in .. ; do \
  if [ X$file != X.. ]; then \
    echo "#include_next <$file>" >>include/$file; \
    chmod a+r include/$file; \
  fi; \
done
rm -f include/stdint.h
if [ wrap = wrap ]; then \
  rm -f include/stdint-gcc.h; \
  cp ../../gcc-15.2.0/gcc/ginclude/stdint-gcc.h include/stdint-gcc.h; \
  chmod a+r include/stdint-gcc.h; \
  cp ../../gcc-15.2.0/gcc/ginclude/stdint-wrap.h include/stdint.h; \
  chmod a+r include/stdint.h; \
elif [ wrap = provide ]; then \
  cp ../../gcc-15.2.0/gcc/ginclude/stdint-gcc.h include/stdint.h; \
  chmod a+r include/stdint.h; \
fi
set -e; for ml in `cat fixinc_list`; do \
  sysroot_headers_suffix=`echo ${ml} | sed -e 's/;.*$//'`; \
  multi_dir=`echo ${ml} | sed -e 's/^[^;]*;//'`; \
  include_dir=include${multi_dir}; \
  if [ -f `echo /usr/include | sed -e :a -e 's,[^/]*/\.\.\/,,' -e ta`/limits.h ] ; then \
    cat ../../gcc-15.2.0/gcc/limitx.h ../../gcc-15.2.0/gcc/glimits.h ../../gcc-15.2.0/gcc/limity.h > tmp-xlimits.h; \
  else \
    cat ../../gcc-15.2.0/gcc/glimits.h > tmp-xlimits.h; \
  fi; \
  /bin/sh ../../gcc-15.2.0/gcc/../mkinstalldirs ${include_dir}; \
  chmod a+rx ${include_dir} || true; \
  /bin/sh ../../gcc-15.2.0/gcc/../move-if-change \
    tmp-xlimits.h  tmp-limits.h; \
  rm -f ${include_dir}/limits.h; \
  cp -p tmp-limits.h ${include_dir}/limits.h; \
  chmod a+r ${include_dir}/limits.h; \
  cp ../../gcc-15.2.0/gcc/gsyslimits.h ${include_dir}/syslimits.h; \
done
if [ xstmp-fixinc != x ]; then \
  rm -f include-fixed/README; \
  cp ../../gcc-15.2.0/gcc/../fixincludes/README-fixinc include-fixed/README; \
  chmod a+r include-fixed/README; \
fi;
