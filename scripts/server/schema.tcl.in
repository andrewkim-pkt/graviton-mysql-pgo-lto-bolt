#!/bin/tclsh
# Build the @WH@ WH TPC-C schema on @HOST@. Run from the client box; dsbuildlb.sh fills the
# placeholders in. Build VU count is @BUILDVU@ -- one loader thread per ~2 warehouses is plenty
# and more loaders on a small box just contend.
puts "SETTING CONFIGURATION"
dbset db mysql
dbset bm TPC-C
diset connection mysql_host @HOST@
diset connection mysql_port 3306
diset tpcc mysql_user root
diset tpcc mysql_pass mysql
diset tpcc mysql_dbase tpcc
diset tpcc mysql_storage_engine innodb
diset tpcc mysql_partition false
diset tpcc mysql_count_ware @WH@
diset tpcc mysql_num_vu @BUILDVU@
vuset logtotemp 1
buildschema
waittocomplete
puts "SCHEMA BUILD COMPLETE"
